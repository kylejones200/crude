{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kylejones200/crude/schemas/static-blend.v1.json",
  "title": "BlendScenario",
  "type": "object",
  "required": ["name", "components"],
  "properties": {
    "name": { "type": "string" },
    "total_volume_bbl": { "type": "number", "minimum": 0 },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["crude", "fraction"],
        "properties": {
          "crude": { "type": "string" },
          "fraction": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "constraints": {
      "type": "object",
      "properties": {
        "api_gravity": { "$ref": "#/$defs/propertyBound" },
        "sulfur_wt_pct": { "$ref": "#/$defs/propertyBound" },
        "total_acid_number": { "$ref": "#/$defs/propertyBound" }
      }
    }
  },
  "$defs": {
    "propertyBound": {
      "type": "object",
      "properties": {
        "min": { "type": "number" },
        "max": { "type": "number" }
      }
    }
  }
}
